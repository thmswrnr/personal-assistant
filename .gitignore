# Local planning / scratch docs (IDEA, PLAN, QUESTIONS_TODO)
planning/

# Secrets & environment
.env

# Claude Code local settings
.claude/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Node (if running tooling locally)
node_modules/
npm-debug.log*

# Python local dev
.venv/
__pycache__/
*.pyc

# Everything a container mounts lives under data/. Most of it is runtime state; the few
# authored files below are whitelisted back in.

# User files & secrets — keep the folders, ignore the contents
data/storage/*
!data/storage/.gitkeep
data/secrets/*
!data/secrets/.gitkeep

# SearXNG: settings.yml is authored config, nothing else belongs here.
!data/searxng/
data/searxng/*
!data/searxng/settings.yml

# Home Assistant's config dir — your home's state, tokens and its own secrets file.
data/homeassistant/

# Downloaded speech-to-text models.
data/whisper/

# pi config dir: ignore everything pi generates at runtime (sessions, auth, trust,
# downloaded bin/, npm/, rolling context) and track ONLY the config we author.
# Whitelist approach, so new pi runtime files are ignored by default.
data/pi/*
!data/pi/models.json
!data/pi/SYSTEM.md
# settings.json is authored config, not runtime state: the model defaults, the custom_skills
# path, and the installed-package list all live here. pi also rewrites `theme` and
# `lastChangelogVersion` in it, so expect occasional churn on those two keys.
!data/pi/settings.json
# Track our own extension source (any .mjs we author), but not runtime files pi drops here.
# The un-ignore/re-ignore pair on the directory is what lets the *.mjs negation reach inside it.
!data/pi/extensions/
data/pi/extensions/*
!data/pi/extensions/*.mjs
# Track our custom subagent definitions (they inherit Core's model unless they pin one)
!data/pi/agents/
!data/pi/agents/*.md
# Track the skill packages — they are version-controlled source, not runtime state
!data/pi/skills/
