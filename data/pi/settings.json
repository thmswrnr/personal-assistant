{
  "lastChangelogVersion": "0.84.4",
  "skills": [
    "/app/storage/custom_skills"
  ],
  "packages": [
    "npm:@tintinweb/pi-subagents@0.10.3"
  ],
  "extensions": [
    "/app/.pi/extensions/spill-to-file.mjs",
