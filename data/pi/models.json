{
  // ── Your model provider ───────────────────────────────────────────────────────────────────
  // Core is model-agnostic. To point it at ANY OpenAI-compatible API, edit just three things:
  //   1. baseUrl below            — your endpoint (this file)
  //   2. LLM_API_KEY in .env      — your key (env, so it stays out of version control)
  //   3. defaultModel in settings.json + the model id(s) listed here
  //
  // "openai-completions" is the OpenAI chat-completions wire format — spoken by Alan, OpenAI,
  // Groq, OpenRouter, Together, vLLM, LM Studio, llama.cpp, and most others. apiKey supports
  // $ENV interpolation ($LLM_API_KEY here); baseUrl is a literal string. If you self-host a
  // model (llama.cpp, vLLM, LM Studio, …), set baseUrl to its host:port and any LLM_API_KEY value
  // (a local server ignores it). For pi's BUILT-IN providers (anthropic/openai/gemini, etc.)
  // you don't need an entry here at all — set their standard key env var and reference the model
  // as "<provider>/<id>" in settings.json.
  //
  // Shipped default: Comma-Soft Alan's OpenAI-compatible endpoint. Change it to your own.
  "providers": {
    "api": {
      "baseUrl": "https://app.alan.de/api/v1/oai",
      "api": "openai-completions",
      "apiKey": "$LLM_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "comma-soft/gemma4-31b",
          "name": "Gemma 4 — thinking",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32768,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "comma-soft/gemma4-31b-instant",
          "name": "Gemma 4 — instant (no reasoning)",
          "reasoning": false,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32768,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "comma-soft/comma-llm-agentic-nonreasoning",
          "name": "GLM agentic — instant (no reasoning)",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 32768,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "comma-soft/comma-llm-agentic",
          "name": "GLM agentic — thinking",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 32768,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "openai/gpt-5.2",
          "name": "GPT-5.2",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 32768,
          "compat": { "maxTokensField": "max_completion_tokens" },
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "openai/gpt-5.4",
          "name": "GPT-5.4",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 32768,
          "compat": { "maxTokensField": "max_completion_tokens" },
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    },

    // ── A model server on your own machine ────────────────────────────────────────────────
    // Same wire format, different endpoint. host.docker.internal reaches the HOST from inside
    // Core's container (docker-compose.yml maps it via extra_hosts).
    //
    // The server loads a model on first request and swaps as you switch, so the FIRST call to a
    // cold model is slow (seconds to minutes for the 30B). Each id below is what the server
    // reports at /v1/models; contextWindow matches its configured --ctx-size. Re-check with:
    //   curl -s http://localhost:8080/v1/models
    // The server must be running — pi does not fall back to `api` if it isn't.
    "local": {
      "baseUrl": "http://host.docker.internal:8080/v1",
      "api": "openai-completions",
      "apiKey": "$LLM_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "gemma-4-12b-it-Q5_K_M",
          "name": "Gemma 4 12B (local)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 49152,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "gpt-oss-20b-Q8_0",
          "name": "gpt-oss 20B (local)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "Qwen3-Coder-30B-A3B-Instruct-Q4_K_M",
          "name": "Qwen3 Coder 30B (local, no reasoning)",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "Qwen3.5-4B-Q6_K",
          "name": "Qwen3.5 4B (local)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 49152,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
